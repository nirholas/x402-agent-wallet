# ── Where the money goes ─────────────────────────────────────────────────────
# Both rails ship pre-filled with the x402 Suite's public receive addresses, so
# the daemon runs out of the box. Change them to YOUR addresses to get paid.

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# ── Networks ─────────────────────────────────────────────────────────────────
# EVM rail: base-sepolia (default, testnet) or base (mainnet).
NETWORK=base-sepolia
# Solana rail: mainnet-beta (default) or devnet.
SOLANA_NETWORK=mainnet-beta

# ── Facilitators (verify + settle) ───────────────────────────────────────────
# One per rail, because coverage differs:
#   x402.org           → base-sepolia, solana-devnet   (free, testnet)
#   facilitator.payai  → base, base-sepolia, solana    (free, no API key)
FACILITATOR_URL=https://x402.org/facilitator
SOLANA_FACILITATOR_URL=https://facilitator.payai.network
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Sponsor account that pays the SOL network fee so buyers need only USDC.
# Leave unset to use the facilitator's published fee payer.
# SOLANA_FEE_PAYER=

# ── Policy ───────────────────────────────────────────────────────────────────
# The wallet policy in force. See config/policy.json for every field.
POLICY_FILE=config/policy.json
# Where settled spends and evaluated intents are persisted.
LEDGER_FILE=data/spend-ledger.json

# ── Auth ─────────────────────────────────────────────────────────────────────
# Guards GET /ledger and POST /record-spend. CHANGE THIS before exposing the
# daemon — the ledger reveals everything the agent has bought.
ADMIN_KEY=dev-admin-key

# ── Signing ──────────────────────────────────────────────────────────────────
# Secret for the HMAC-SHA256 signatures on policy verdicts. A dev default is
# used when unset — ALWAYS set your own in production, or verdicts are forgeable.
# SIGNING_SECRET=change-me

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4032
# Public origin used in the 402 `resource` field when behind a proxy.
# PUBLIC_BASE_URL=https://wallet.example.com

# ── Client example (examples/agent-client.ts) ────────────────────────────────
# Funded base-sepolia wallet the example agent pays with.
# PRIVATE_KEY=0x...
# Optional Solana signer (base58 secret key) to demo the Solana rail.
# SOLANA_PRIVATE_KEY=
# BASE_URL=http://localhost:4032
